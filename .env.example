# myslt-alerts configuration.
#
# Copy this file to .env and fill in your own values. .env is gitignored, so your
# real credentials stay on your machine.
#
# check.mjs reads plain environment variables and does not parse .env by itself, so
# load the file before running:
#
#   node --env-file=.env check.mjs        (Node 20.6 and newer, recommended)
#   set -a && . ./.env && set +a && node check.mjs    (older Node, see warning below)
#
# Wrap your values in single quotes when you fill them in. The second command SOURCES
# this file, meaning the shell EXECUTES it: an unquoted $, backtick or $(...) in a
# password would run as a command, and an unquoted # would silently truncate the value.
#
# Running on GitHub Actions instead? Do not commit a filled-in .env. Add each value
# as a repository secret under Settings, Secrets and variables, Actions.
#
# Every value below is a placeholder. Replace all of them.


# ---------------------------------------------------------------------------
# 1. MySLT account (required)
# ---------------------------------------------------------------------------

# The username you use to sign in to the MySLT app or portal. For most accounts
# this is an email address, though some older accounts use a plain username.
SLT_USERNAME=you@example.com

# Your MySLT password. Same one you sign in with.
SLT_PASSWORD=your-myslt-password

# Your SLT account number in international format: country code 94, then the
# number, with no plus sign and no spaces. It is 11 digits in total and you can
# find it in the MySLT app or on your bill.
SLT_SUBSCRIBER_ID=94XXXXXXXXX


# ---------------------------------------------------------------------------
# 2. Where to send alerts (pick at least one)
# ---------------------------------------------------------------------------
#
# There are three channels: WhatsApp (Green API), Telegram, and SMS (text.lk).
# You only need one. If you configure more than one, the script still sends
# through a single channel, the first available in this order: SMS (text.lk),
# WhatsApp (Green API), Telegram. It does not fan out to all of them. Configure
# exactly one and that order never comes up. Leave the rest completely blank.


# --- WhatsApp via Green API (recommended) ----------------------------------
#
# Recommended because it is what this project actually runs on in production,
# every day, and it is the only channel whose delivery has been confirmed end to
# end. Telegram and text.lk are supported and their code is here, but nobody has
# yet confirmed a real message arriving through either one.
#
# Two drawbacks you should know about before you pick this, both learned the
# hard way:
#
#   1. The free "Developer" tier caps you at 3 distinct chat contacts per month.
#      Alerting yourself is fine. Alerting a household is not.
#   2. Green API sends by linking a real WhatsApp account as a linked device.
#      Re-linking the same number over and over can get it flagged by WhatsApp's
#      anti-abuse systems. That happened to the bot number used for this project
#      and it was unusable for roughly three weeks. Scan the QR once, then leave
#      the instance alone.
#
# If either of those matters to you, use Telegram below instead, keeping in mind
# that its path here is unproven.
#
# Setup: sign up at green-api.com, create an instance, scan the QR from the
# WhatsApp account that will do the sending, then copy the values from your
# instance dashboard.

# Instance id, shown on the instance page.
GREENAPI_ID_INSTANCE=1234567890

# Instance API token. Keep this secret.
GREENAPI_API_TOKEN=your-green-api-instance-token

# Recipient in international format, no plus sign. Either form works, and the
# script appends @c.us for you if you leave it off.
GREENAPI_CHAT_ID=947XXXXXXXX

# Your instance host. Optional. Defaults to https://api.green-api.com if unset.
# Newer instances get a numbered host, shown in your dashboard.
GREENAPI_API_URL=https://1234.api.greenapi.com


# --- Telegram --------------------------------------------------------------
#
# The alternative to Green API. Free, official API, no contact cap, and no
# linked device to get flagged, so it avoids both of the drawbacks above. The
# trade-off is honesty: this project's Telegram path has not had a delivery
# confirmed yet, so treat your first run as the test. `node check.mjs --now`
# sends immediately and tells you which channel it used.
#
# Setup: message @BotFather on Telegram, send /newbot, and copy the token it
# gives you. Then message your new bot once and open
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates to find your chat id.

TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=123456789


# --- SMS via text.lk (Sri Lanka) -------------------------------------------
#
# An SMS gateway, useful if you want alerts that arrive without mobile data.
# It needs a paid top-up once the trial credits run out, and its delivery path
# here is also unconfirmed. Note that if you fill this in alongside another
# channel, this is the one that wins.
#
# Sign up at text.lk and copy your API token. Messages are stripped to plain
# ASCII on one line so they stay within a single SMS segment.

TEXTLK_API_TOKEN=your-textlk-api-token

# Your phone number in international format, no plus sign.
TEXTLK_RECIPIENT=947XXXXXXXX

# Sender id shown on the message. Optional. Defaults to the gateway's demo
# sender if unset. Set your own only once text.lk has approved it.
TEXTLK_SENDER_ID=YourSenderID
